NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://chatforum:CHANGE_ME@127.0.0.1:3306/chatforum
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_ACCESS_SECRET=replace-with-random-32-byte-secret
JWT_REFRESH_SECRET=replace-with-another-random-32-byte-secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
DEFAULT_MODEL_API_KEY=
DEFAULT_MODEL_API_BASE=https://api.deepseek.com
DEFAULT_MODEL_NAME=deepseek-chat
# Browser-selectable models: IDs are fixed by server code; credentials never sent to the browser.
CHAT_DEFAULT_MODEL=qwen3.8-max
# Do not use the personal DeepSeek balance. Re-enable only with an explicit owner choice.
DEEPSEEK_CHAT_ENABLED=false
# Empty DeepSeek key reuses DEFAULT_MODEL_API_KEY only when its endpoint is api.deepseek.com.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DASHSCOPE_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_NAME=qwen3.8-max-0902
# Optional, model-specific rates; no automatic reuse of another model's rates.
# DEEPSEEK_V4_PRO_INPUT_CNY_PER_MILLION=
# DEEPSEEK_V4_PRO_OUTPUT_CNY_PER_MILLION=
# QWEN38_MAX_INPUT_CNY_PER_MILLION=
# QWEN38_MAX_OUTPUT_CNY_PER_MILLION=
# DEEPSEEK_V4_PRO_CACHED_INPUT_CNY_PER_MILLION=
# QWEN38_MAX_CACHED_INPUT_CNY_PER_MILLION=
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
# Change when a provider silently replaces model weights; rebuild the index afterwards.
EMBEDDING_REVISION=default
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
RAG_WORKER_ENABLED=true
CHAT_WORKER_ENABLED=true
# Concurrent workers; per-user task exclusivity still applies. This is not a usage quota.
CHAT_WORKER_CONCURRENCY=2
# Conservative single-request context packing estimate, NOT a whole-task token limit.
MODEL_CONTEXT_TOKEN_BUDGET=48000
ASSISTANT_CONTEXT_TOKEN_BUDGET=96000
# Usage/cost/time are observations only. There are no AGENT_TASK_* hard limits.
LOCAL_MONITOR_ENABLED=false
LOCAL_MONITOR_BIND=127.0.0.1
LOCAL_MONITOR_PORT=8091
# Set your actual contract rates to show estimated cost; missing = unavailable, not zero.
# RAG_INPUT_CNY_PER_MILLION=
# RAG_OUTPUT_CNY_PER_MILLION=
# RAG_EMBEDDING_CNY_PER_MILLION=
