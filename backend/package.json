{
  "name": "chatforum-backend",
  "version": "1.0.0",
  "description": "ChatForum 智能对话与社区交流平台 - 后端服务",
  "author": "PengYao",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "setup": "npm ci --legacy-peer-deps && npx prisma generate && npx prisma migrate deploy",
    "eval:novel": "ts-node src/modules/agent/eval/novel-eval.cli.ts",
    "eval:score": "ts-node src/modules/agent/eval/novel-score.cli.ts",
    "test:integration": "jest --runInBand rag.integration.spec",
    "bootstrap": "node dist/src/bootstrap-admin.js"
  },
  "dependencies": {
    "@langchain/core": "^0.3.80",
    "@langchain/openai": "^0.3.17",
    "@napi-rs/canvas": "1.0.9",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.3.1",
    "@nestjs/throttler": "^5.2.0",
    "@prisma/client": "^5.14.0",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "docx": "9.7.1",
    "express": "^4.22.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.3.37",
    "mammoth": "1.12.3",
    "multer": "^2.3.0",
    "pdf-parse": "^1.1.4",
    "pdfjs-dist": "6.3.289",
    "pdfkit": "0.20.2",
    "nodemailer": "10.1.0",
    "prisma": "^5.14.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.13.0",
    "xss-clean": "^0.1.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.3.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "multer": "$multer",
    "lodash": "^4.18.1",
    "js-yaml": "^4.3.2",
    "qs": "^6.16.0",
    "body-parser": "1.20.9",
    "proxy-addr": "2.0.8",
    "handlebars": "4.7.10",
    "langsmith": "^0.6.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kato-Megumi1/chatforum.git"
  }
}
