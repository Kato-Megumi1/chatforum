# Leave API unset to use /api locally. Pages uses repository variable PUBLIC_API_BASE_URL.
# This is a public HTTPS /api address, never a model key or a login token.
# Production ignores localStorage overrides. The connection editor exists only in npm run dev.
# Pages builds fail if this address is missing or is not HTTPS with path /api.
VITE_API_BASE_URL=
VITE_PAGES=false
VITE_BASE_PATH=/
